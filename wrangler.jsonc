{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finbot",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "miniapp/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/webhook/*",
			"/setup*"
		]
	},
	// database_id sengaja tidak diisi: Cloudflare membuat D1 otomatis saat deploy pertama.
	// Migrasi dijalankan oleh worker/db/migrate.ts lewat halaman /setup (bukan wrangler d1 migrations).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finbot-db",
			"database_id": "2cf3838f-e50d-40d3-bb86-8e00554bdd2f"
		}
	],
	// File migrasi .sql di-import sebagai teks.
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.sql"
			],
			"fallthrough": true
		}
	],
	// Tiap jam; logika cek jam WIB ada di kode.
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"vars": {
		"APP_VERSION": "1.0.0"
	},
	"observability": {
		"enabled": true
	}
}